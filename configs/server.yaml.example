# server.yaml — Gitwo 平台的可选配置。
# 位置：<程序目录>/data/server.yaml（默认无需此文件，全部有合理默认值）。
# 未知字段会被拒绝启动（防拼写错误），修改后重启 gitwo 生效。

# 监听地址；Gitea 式入口：Web UI / git / 流水线 / 站点 全部走这一个端口
listen: :9527

# SSH Git 服务监听。缺省 ":2222"；设为空串("")禁用 SSH。
# 主机密钥首次启动自动生成于 data/ssh/ssh_host_ed25519_key。
# ssh_listen: ":2222"

# 可选：显式指定 git 可执行文件路径。默认自动解析（PATH → 常见安装位置）。
# git 装在非标准目录、或服务以精简环境启动（PATH 不含 git）时设置此项。
# 也可用环境变量 GITWO_GIT=<git 绝对路径> 覆盖。
# git_path: "C:\Program Files\Git\cmd\git.exe"
#
# 找不到 git 时是否自动安装（默认 true）：
#   Windows 用 winget（winget install --id Git.Git），Ubuntu 用 apt-get，
#   CentOS Stream 用 yum/dnf。离线/受限环境可设为 false——此时启动会
#   直接报错并提示手动安装，不会启动服务。
# auto_install_git: true

# 部署并发：全局最多同时部署 workers 个仓库；同一仓库内任务严格串行
workers: 2
max_queued_per_repo: 5        # 每仓库排队上限，超出丢弃新任务

# 前端部署后是否校验 index.html 存在（deploy.yaml 中可按项目覆盖）
verify_index: true

# 未显式指定 run.port 的服务自动分配端口时的扫描范围
# （端口注入为 $PORT，服务应读取该环境变量监听）
port_min: 20000
port_max: 23999

# 部署结束（成功/失败）时向该 URL POST 结果摘要（JSON，含
# task_id/repo/branch/commit/status/duration_ms/error）。留空禁用。
# notify_webhook: "https://example.com/hook"

# 各步骤超时
timeouts:
  git: 5m          # clone / fetch / checkout
  build: 10m       # 每条构建命令
  deploy: 5m       # rsync / 二进制安装
  stop: 15s        # SIGTERM 后等待进程退出，超时 SIGKILL
  start_wait: 2s   # 服务启动后等待并确认存活的时间
